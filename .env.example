# Optional API keys for live LLM diagnostic agents.
# Without keys, the system uses deterministic fallback mode.

GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional model override (provider-specific default is used when unset)
# LLM_MODEL=openai/gpt-oss-120b

# Langfuse remote connector (pull GENERATION observations)
# Never commit real keys. Secrets are env-only — not stored in connection profiles.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional host (default: https://cloud.langfuse.com)
# US cloud: https://us.cloud.langfuse.com
# Self-hosted: https://langfuse.example.com
# LANGFUSE_HOST=https://cloud.langfuse.com
